rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // Reads the caller's user document.
    // Firestore caches get() results within a single rule evaluation,
    // so this is only one extra read per request even if called multiple times.
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myOrgId() {
      return me().organizationId;
    }

    function myRole() {
      return me().role;
    }

    // User belongs to the given org.
    function belongsToOrg(orgId) {
      return isSignedIn() && myOrgId() == orgId;
    }

    // Only admin and nutritionist roles can write data.
    // Handles 'nutritionist' (English) and 'nutricionista' (PT) role strings.
    // 'viewer' gets read-only access.
    function canWrite(orgId) {
      return belongsToOrg(orgId) && (
        myRole() == 'admin'        ||
        myRole() == 'nutricionista' ||
        myRole() == 'nutritionist'
      );
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Each user can read and write their own profile.
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      // Org admins can read other members' profiles (needed for team management).
      allow read: if isSignedIn()
        && myRole() == 'admin'
        && get(/databases/$(database)/documents/users/$(userId)).data.organizationId == myOrgId();
    }

    // ── Organizations ─────────────────────────────────────────────────────────
    match /organizations/{orgId} {
      // Only members of the org can read org metadata directly.
      // Invite-code resolution for new members is handled by the server.
      allow read: if belongsToOrg(orgId);

      // Only the registering user can create an org, and only with their own email.
      // Because org creation now happens after createUserWithEmailAndPassword,
      // request.auth is always the real user at this point.
      allow create: if isSignedIn()
        && request.resource.data.ownerEmail == request.auth.token.email;

      // Org admins can update settings, BUT cannot modify Stripe-controlled fields.
      // Only the server-side Firebase Admin SDK (Stripe webhook) can change those.
      allow update: if isSignedIn()
        && myOrgId() == orgId
        && myRole() == 'admin'
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'subscriptionStatus', 'plan', 'stripeCustomerId',
          'stripeSubscriptionId', 'trialEndsAt', 'activatedAt'
        ]);

      // Orgs are never deleted from the client.
      allow delete: if false;

      // ── Org sub-collections ────────────────────────────────────────────────
      // Any org member (admin, nutricionista, viewer) can READ all sub-collections.
      // Only admin and nutritionist roles can CREATE, UPDATE, DELETE.
      match /{collection}/{docId} {
        allow read:   if belongsToOrg(orgId);
        allow write:  if canWrite(orgId);
      }
    }

    // ── notificationSettings (per-user notification preferences) ─────────────
    // Each user can only read and write their own notification settings.
    match /notificationSettings/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // ── training_tokens (global — powers the public QR-scan attendance page) ──
    // TrainingAttend is a public unauthenticated page, so read must be open.
    // Writes are restricted to authenticated users from the token's owner org.
    match /training_tokens/{token} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['orgId', 'trainingId'])
        && myOrgId() == request.resource.data.orgId;

      allow update: if isSignedIn() && myOrgId() == resource.data.orgId;
      allow delete: if isSignedIn() && myOrgId() == resource.data.orgId;
    }

    // ── Legacy flat collections (pre-multi-tenancy backward compatibility) ────
    // pnae_trainings: public read so TrainingAttend fallback still works for
    // tokens created before the org-scoped migration. No new writes allowed.
    match /pnae_trainings/{docId} {
      allow read:  if true;
      allow write: if false;
    }

    // pnae_training_attendees: readable by authenticated users only (not public).
    // No new writes — all new attendees go to organizations/{orgId}/training_attendees.
    match /pnae_training_attendees/{docId} {
      allow read:  if isSignedIn();
      allow write: if false;
    }
  }
}
