# ─────────────────────────────────────────────────────────────────────────────
# EduPlate Menu — Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA faça commit do arquivo .env no git.
# ─────────────────────────────────────────────────────────────────────────────

# URL pública da aplicação (sem barra final)
APP_URL=http://localhost:3000

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_COLE_SUA_CHAVE_AQUI
STRIPE_WEBHOOK_SECRET=whsec_COLE_AQUI

# Price IDs dos planos (Stripe Dashboard → Products → Price ID)
STRIPE_PRICE_ESSENCIAL=price_COLE_AQUI
STRIPE_PRICE_PRO=price_COLE_AQUI
STRIPE_PRICE_ENTERPRISE=price_COLE_AQUI

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# JSON completo em uma linha (sem quebras de linha)
# Firebase Console → Project Settings → Contas de serviço → Gerar nova chave
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"SEU_PROJECT_ID",...}
